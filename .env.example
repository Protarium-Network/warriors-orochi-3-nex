# Local preservation mode (accounts from settings.json, token not validated).
PN_WO3_LOCAL_MODE=1
PN_WO3_SECURE_HOST=localhost
PN_WO3_KERBEROS_PASSWORD=change-me
# Set to 1 if the console reports 106-0502 (see README "Configuration").
# PN_WO3_LEGACY_SIGNATURE=0
# Shared mode (account server): PN_WO3_LOCAL_MODE=0 plus
# PN_WO3_NEX_TOKEN_AES_KEY=<64 hex>   PN_WO3_NEX_PASSWORD_SECRET=<>=32 bytes hex>
# DataStore uploads (replays / clips) need an S3-compatible backend:
# PN_S3_ENDPOINT= PN_S3_ACCESS_KEY= PN_S3_SECRET_KEY= PN_S3_BUCKET=wo3-datastore
